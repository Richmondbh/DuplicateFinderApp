<Window x:Class="DuplicateFinderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicate Finder" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#F3F5F8">

    <!-- Styles: shared look for all controls of the same type -->
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,20,4" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,20,4" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style TargetType="ListView">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">

        <!-- Status bar at the bottom of the window -->
        <StatusBar DockPanel.Dock="Bottom" Background="Transparent">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Select a folder to start." />
            </StatusBarItem>
        </StatusBar>

        <!-- 1. Folder selection -->
        <GroupBox Header="1. Folder to search" DockPanel.Dock="Top">
            <DockPanel>
                <Button x:Name="btnBrowse" Content="Browse..." DockPanel.Dock="Right"
                        Margin="8,0,0,0" Click="BtnBrowse_Click" />
                <TextBox x:Name="txtFolder" IsReadOnly="True" VerticalContentAlignment="Center" />
            </DockPanel>
        </GroupBox>

        <!-- 2. Attributes and 3. file types, side by side -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="2. Compare files by">
                <WrapPanel>
                    <CheckBox x:Name="chkName" Content="Name" />
                    <CheckBox x:Name="chkSize" Content="Size" IsChecked="True" />
                    <CheckBox x:Name="chkDate" Content="Date modified" IsChecked="True" />
                    <CheckBox x:Name="chkHash" Content="Content (hash)"
                              ToolTip="Compares the actual contents of the files. Most accurate, but slower." />
                </WrapPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="3. File type">
                <WrapPanel>
                    <RadioButton x:Name="rbAll" Content="All files" GroupName="FileType" IsChecked="True" />
                    <RadioButton x:Name="rbPictures" Content="Pictures (.jpg, .png)" GroupName="FileType" />
                    <RadioButton x:Name="rbPdf" Content="PDF (.pdf)" GroupName="FileType" />
                    <RadioButton x:Name="rbText" Content="Text (.txt)" GroupName="FileType" />
                </WrapPanel>
            </GroupBox>
        </Grid>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnFind" Content="Find duplicates" Click="BtnFind_Click" />
            <Button x:Name="btnCancel" Content="Cancel" IsEnabled="False" Click="BtnCancel_Click" />
            <Button x:Name="btnDelete" Content="Delete duplicates" IsEnabled="False"
                    Foreground="DarkRed" Click="BtnDelete_Click" />
            <ProgressBar x:Name="progressBar" Width="200" Height="16" Margin="8,0,0,0"
                         IsIndeterminate="True" Visibility="Collapsed" />
        </StackPanel>

        <!-- Results: originals on the left, their duplicates on the right -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- List one: the first occurrence of every file that has duplicates -->
            <GroupBox Grid.Column="0" Header="Files that have duplicates (first occurrence)">
                <ListView x:Name="lvOriginals" SelectionMode="Single"
                          SelectionChanged="LvOriginals_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="170"
                                            DisplayMemberBinding="{Binding Original.Name}" />
                            <GridViewColumn Header="Folder" Width="170"
                                            DisplayMemberBinding="{Binding Original.DirectoryName}" />
                            <GridViewColumn Header="Size" Width="90"
                                            DisplayMemberBinding="{Binding Original.Length, StringFormat='{}{0:N0} B'}" />
                            <GridViewColumn Header="Copies" Width="55"
                                            DisplayMemberBinding="{Binding Duplicates.Count}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

            <!-- List two: the duplicates of the file selected in list one -->
            <GroupBox Grid.Column="2" Header="Duplicates of the selected file">
                <ListView x:Name="lvDuplicates">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="150"
                                            DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Folder" Width="170"
                                            DisplayMemberBinding="{Binding DirectoryName}" />
                            <GridViewColumn Header="Size" Width="90"
                                            DisplayMemberBinding="{Binding Length, StringFormat='{}{0:N0} B'}" />
                            <GridViewColumn Header="Modified" Width="115"
                                            DisplayMemberBinding="{Binding LastWriteTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
